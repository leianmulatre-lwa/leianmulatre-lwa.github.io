rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Moderators are a hand-edited list. A document here means the account may review
    // media, and nobody can add themselves: the first admin is seeded once by hand.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/moderationAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/moderationAdmins/$(request.auth.uid)).data.active != false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Only these two fields of a public profile may be written by a moderator, and only
    // when the media behind them has actually been approved.
    function onlyModeratedMediaChanged() {
      let after = request.resource.data.look.wallpaperMedia;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['look', 'updatedAt'])
        && (after == null || after.state == 'approved');
    }

    // Public username directory. Anyone may search it.
    match /usernames/{username} {
      allow read: if true;

      // A member may open their own entry, either by stamping their own uid on it or
      // because their account doc already records this username.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid)
        || (isAdmin() && onlyModeratedMediaChanged());
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Account/profile data belongs to the signed-in account. A moderator may clear a
    // rejected wallpaper from a member's account, nothing else.
    match /users/{userId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wallpaper', 'updatedAt'])
          && (request.resource.data.wallpaper == null
            || request.resource.data.wallpaper.state == 'approved'));
    }

    function validStudioState() {
      let value=request.resource.data;
      return value.keys().hasAll(['value','revision','editId','updatedAt'])
        && value.keys().hasOnly(['value','revision','editId','updatedAt'])
        && (value.value == null || (value.value is string && value.value.size() <= 500000))
        && value.revision is int && value.revision > 0
        && value.editId is string && value.editId.size() <= 100
        && value.updatedAt == request.time;
    }
    function validSharedModule(kind) {
      let value=request.resource.data;
      return kind in ['projects','library','closet','trophies']
        && value.keys().hasAll(['value','visibility','updatedAt'])
        && value.keys().hasOnly(['value','visibility','updatedAt'])
        && value.value is string && value.value.size() <= 500000
        && value.visibility in ['public','private'] && value.updatedAt == request.time;
    }
    // Private account backup records; null values are cross-device deletion tombstones.
    match /users/{userId}/studioState/{key} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validStudioState();
      allow delete: if isOwner(userId);
    }
    // Only explicit snapshots are public, and account privacy is checked server-side.
    match /users/{userId}/sharedModules/{kind} {
      allow read: if isOwner(userId) || (resource.data.visibility == 'public'
        && get(/databases/$(database)/documents/users/$(userId)).data.get('accountVisibility','public') != 'private');
      allow create, update: if isOwner(userId) && validSharedModule(kind);
      allow delete: if isOwner(userId);
    }

    // Private note and Journal collections never live in the public directory.
    // Same account on multiple devices can read/write their own writing only.
    match /users/{userId}/writingCollections/{kind} {
      allow read, write: if isOwner(userId) && kind in ['notes','diary'];
    }

    // Collective posts are public only after the owner explicitly publishes them.
    // Draft Orbit imports remain readable only by the Firebase account that owns them.
    match /posts/{postId} {
      allow read: if resource.data.state == 'approved'
        || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.state in ['draft', 'approved'];
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.state in ['draft', 'approved', 'archived', 'pending_delete'];
      allow delete: if isOwner(resource.data.uid);
    }

    /* Every account post is also mirrored under the owner's profile. This gives the member
       a durable per-account post history while the root /posts collection powers the public
       collective feed. The same document id is used in both places.

       Reads: a published card is readable by anyone, which is what lets a visitor open
       another member's profile and see what they actually published. A draft stays
       owner-only. Firestore rejects a whole query when any document in it would fail the
       rule, so a reader must filter on state == 'approved' to see another account. That
       is not a partial leak; the query simply fails closed. */
    match /users/{userId}/posts/{postId} {
      allow read: if isOwner(userId)
        || (resource.data.uid == userId && resource.data.state == 'approved');
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId)
        && resource.data.uid == userId;
    }

    /* Instagram/Orbit Archive. The owner always has access. A card the owner has published
       to the Collective Feed is public, so the Archive and the feed cannot disagree about
       what a visitor may see. Everything still saved only to the Archive stays private. If
       the owner explicitly chooses "friends", a signed-in UID listed in archiveFriends may
       read the rest. Provider credentials and the friend list itself remain owner-only on
       /users/{userId}. */
    match /users/{userId}/archive/{archiveId} {
      allow read: if isOwner(userId)
        || (resource.data.uid == userId && resource.data.state == 'approved')
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(userId)).data.get('archive', {}).get('visibility', 'private') == 'friends'
          && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.get('archiveFriends', []));
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    /* Per-owner retrieval index. The client keeps one small doc per account recording what
       that account owns and by source, so a future search or ranking pass can enumerate an
       owner's media without fanning out across every post. Owner-only, and deliberately
       not readable by others: it is an inventory, not a published surface. */
    match /users/{userId}/index/{indexId} {
      allow read, write: if isOwner(userId);
    }

    /* Map pins. A pin is private to its owner until they choose to publish it, which is
       the whole point of the "make pin public" switch: everything is private by default
       and nothing becomes readable to another account without the owner saying so.
       A published pin carries a name, an area and a photo; the owner can withdraw it at
       any time by setting isPublic back to false, and the strip under the map then stops
       offering it to anyone else. */
    match /mapPins/{pinId} {
      allow read: if resource.data.isPublic == true
        || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(resource.data.uid);
    }

    // Wallpaper moderation queue. Members may open a review for their own media and
    // follow their own queue; only moderators can decide one.
    match /wallpaperReviews/{reviewId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.state == 'pending';

      allow update: if isAdmin();

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // The moderator list itself. A member may check their own entry so the UI knows
    // whether to offer the review widget; only moderators may read or change the list.
    match /moderationAdmins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    /* Veve public Sqwibs. Existing Sqwib drafts never enter Firestore:
       only an explicit owner Publish action creates one of these documents.
       Revocation removes text from all public queries and Veve reshares. */
    match /sqwibs/{sqwibId} {
      allow read: if resource.data.visibility == 'public'
        || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'text', 'visibility', 'allowResqwib', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.visibility == 'public'
        && request.resource.data.allowResqwib is bool;
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'text', 'visibility', 'allowResqwib', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.text == resource.data.text
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.visibility in ['public','private']
        && request.resource.data.allowResqwib is bool
        && (request.resource.data.visibility == 'public'
           || request.resource.data.allowResqwib == false);
      allow delete: if isOwner(resource.data.uid);
    }

    /* A resqwib contains a reference only, never copied source text.
       Publication is denied unless the original author explicitly allowed it.
       Veve rechecks that permission every time it renders a reshare, so
       unpublishing or disabling resqwibs immediately hides the source content. */
    match /sqwibReshares/{reshareId} {
      allow read: if true; // public reference metadata (uid and Sqwib id), not note content
      allow create: if isOwner(request.resource.data.uid)
        && reshareId == request.auth.uid + '_' + request.resource.data.sourceId
        && request.resource.data.keys().hasOnly(['uid','sourceId','createdAt'])
        && request.resource.data.sourceId is string
        && exists(/databases/$(database)/documents/sqwibs/$(request.resource.data.sourceId))
        && get(/databases/$(database)/documents/sqwibs/$(request.resource.data.sourceId)).data.visibility == 'public'
        && get(/databases/$(database)/documents/sqwibs/$(request.resource.data.sourceId)).data.allowResqwib == true
        && get(/databases/$(database)/documents/sqwibs/$(request.resource.data.sourceId)).data.uid != request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }


    /* Public Guest Check entries stay in a dedicated collection. Public read
       never grants anonymous write. A member's connect-only selection is
       enforced by Firestore, not the client's button state. "Connects" means
       the owner's existing approved archiveFriends UID list. */
    match /guestCheckEntries/{ownerUid}/entries/{entryId} {
      allow get, list: if resource.data.visibility == 'public'
        || isOwner(ownerUid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'ownerUid', 'authorUid', 'name', 'note', 'emoji', 'visibility', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'authorUid', 'name', 'note', 'emoji', 'visibility', 'createdAt'
        ])
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdAt == request.time
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 450
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.name == (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('name','') != ''
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('name','')
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('usernameLower','')
        )
        && (
          request.auth.uid == ownerUid
          || get(/databases/$(database)/documents/users/$(ownerUid)).data.get('guestCheckPermission','anyone') == 'anyone'
          || (
            get(/databases/$(database)/documents/users/$(ownerUid)).data.get('guestCheckPermission','anyone') == 'connects'
            && request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)).data.get('archiveFriends',[])
          )
        );
      allow update: if false;
      allow delete: if isOwner(ownerUid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}